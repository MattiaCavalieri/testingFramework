<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Error Handling Suite">
	<groups>
		<run>
			<include name="ErrorsHandling"></include>
		</run>
	</groups>

	<test thread-count="5" name="Submit Order Test">
		<classes>
			<class name="testingFramework.SubmitOrderTest" />
		</classes>
	</test> <!--Test -->
	
	<test thread-count="5" name="Error Validation Test">
		<classes>
			<class name="testingFramework.ErrorValidationsTest" />
		</classes>
	</test> <!--Test -->
</suite> <!--Suite -->
